{
  "expo": {
    "name": "Zombie Squisher",
    "slug": "zombie",
    "owner": "hot-attic-games",
    "version": "1.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "scheme": "zombiesquisher",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9b498cb4-2cf6-4604-8d25-3b2d6be0add7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verbal76.zombiesquisher"
    },
    "android": {
      "package": "com.verbal76.zombiesquisher",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#1e321e"
      },
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0805",
          "image": "./assets/brand/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86_64"
            ]
          }
        }
      ],
      "./plugins/with-no-compress-glb.js"
    ],
    "extra": {
      "eas": {
        "projectId": "9b498cb4-2cf6-4604-8d25-3b2d6be0add7"
      }
    },
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#0d0805"
  }
}
