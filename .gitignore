# Generated icon assets — regenerated by scripts/make-icon.mjs from src/assets/.
assets/icon.png
assets/adaptive-icon.png

# npm lockfile is intentionally NOT committed in this repo. Workflows use
# `npm install` (not `npm ci`) and skip `cache: npm` on setup-node — both
# would require a committed lock. Revisit if CI minutes become a constraint.
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Character GLB / texture binaries — built artifacts. The runtime ships them
# as base64 TS modules in src/assets/character-*.ts; these binaries live here
# so the build scripts (zombify-character-textures, embed-zombie-textures,
# encode-glb-to-ts) can be re-run.
assets/characters/
